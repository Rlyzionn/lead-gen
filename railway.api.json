{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npx prisma generate --schema=apps/api/prisma/schema.prisma && npm run build --workspace=@hha/api",
    "watchPatterns": [
      "apps/api/**",
      "packages/shared/**",
      "package.json",
      "package-lock.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/api && node dist/main.js",
    "healthcheckPath": "/api/activity",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
