    "@nestjs/config": "^3.2.0",
    "@nestjs/bull": "^10.1.1",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/websockets": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "@prisma/client": "^5.14.0",
    "bull": "^4.12.9",
    "ioredis": "^5.4.1",
    "openai": "^4.52.0",
