# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Settings → Database → Connection string. Use the SESSION POOLER URL for Prisma
# (port 5432, hostname starts with aws-* — direct connections often blocked by ISPs).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_KEY="<your-service-role-jwt>"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-jwt>"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Scraping ──────────────────────────────────────────────────────────────────
APIFY_TOKEN=""

# ── Enrichment ────────────────────────────────────────────────────────────────
APOLLO_API_KEY=""

# ── SMS / Voice (Twilio) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""

# ── Email (Gmail OAuth) ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Calendar ──────────────────────────────────────────────────────────────────
CALENDLY_API_KEY=""

# ── CRM (Microsoft Dynamics) ──────────────────────────────────────────────────
DYNAMICS_TENANT_ID=""
DYNAMICS_CLIENT_ID=""
DYNAMICS_CLIENT_SECRET=""
DYNAMICS_RESOURCE_URL=""

# ── Real-time ─────────────────────────────────────────────────────────────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NODE_ENV="development"

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run without any real integrations (no Twilio, Gmail, Dynamics,
# Apollo, Apify, or OpenAI required). All data is simulated with realistic fakes.
# Seed the DB first: cd apps/api && npx prisma db seed
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
